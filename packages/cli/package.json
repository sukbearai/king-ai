{
  "name": "@suwujs/king-ai",
  "version": "0.2.34",
  "description": "King AI, a local BYOA agent daemon that bridges remote runtime events to Claude or Codex CLI.",
  "type": "module",
  "bin": {
    "king-ai": "dist/src/cli.js"
  },
  "exports": {
    "./host-sdk": {
      "types": "./dist/src/host-sdk.d.ts",
      "default": "./dist/src/host-sdk.js"
    },
    "./cron": {
      "types": "./dist/src/cron.d.ts",
      "default": "./dist/src/cron.js"
    },
    "./message-routing": {
      "types": "./dist/src/message-routing.d.ts",
      "default": "./dist/src/message-routing.js"
    },
    "./team-routing": {
      "types": "./dist/src/team-routing.d.ts",
      "default": "./dist/src/team-routing.js"
    },
    "./workflow-core": {
      "types": "./dist/src/workflow-core.d.ts",
      "default": "./dist/src/workflow-core.js"
    },
    "./team-workflow": {
      "types": "./dist/src/team-workflow.d.ts",
      "default": "./dist/src/team-workflow.js"
    },
    "./attachments": {
      "types": "./dist/src/attachments.d.ts",
      "default": "./dist/src/attachments.js"
    },
    "./run-stream": {
      "types": "./dist/src/run-stream.d.ts",
      "default": "./dist/src/run-stream.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/test/*.test.js",
    "verify": "pnpm build && pnpm test",
    "dev": "tsx src/cli.ts"
  },
  "files": [
    "dist/src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cleye": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
