{
  "name": "king-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for King AI CLI and app integrations.",
  "scripts": {
    "build": "pnpm --filter @suwujs/king-ai build && pnpm --filter @king-ai/gui-worker build",
    "test": "pnpm --filter @suwujs/king-ai test && pnpm --filter @king-ai/gui-worker test",
    "verify": "pnpm build && pnpm test",
    "dev": "node scripts/dev-cli.mjs",
    "gui:dev": "pnpm --filter @king-ai/gui-worker dev",
    "gui:dev:lan": "pnpm --filter @king-ai/gui-worker dev:lan",
    "gui:deploy": "pnpm --filter @king-ai/gui-worker deploy"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "kysely": "0.28.17"
    }
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
