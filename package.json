{
  "name": "king-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for king CLI and app integrations.",
  "scripts": {
    "build": "pnpm --filter @suwujs/king build && pnpm --filter @king/gui-worker build",
    "test": "pnpm --filter @suwujs/king test && pnpm --filter @king/gui-worker test",
    "verify": "pnpm build && pnpm test",
    "dev": "pnpm --filter @suwujs/king dev",
    "gui:dev": "pnpm --filter @king/gui-worker dev",
    "gui:deploy": "pnpm --filter @king/gui-worker deploy"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
