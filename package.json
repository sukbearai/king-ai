{
  "name": "king-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for King AI CLI and app integrations.",
  "scripts": {
    "build": "pnpm --filter @suwujs/king-ai build && pnpm --filter @king-ai/gui-worker build",
    "test": "pnpm --filter @suwujs/king-ai test && pnpm --filter @king-ai/gui-worker test",
    "verify": "pnpm build && pnpm test",
    "dev": "node scripts/dev-cli.mjs",
    "gui:dev": "pnpm --filter @king-ai/gui-worker dev",
    "gui:dev:lan": "pnpm --filter @king-ai/gui-worker dev:lan",
    "gui:deploy": "pnpm --filter @king-ai/gui-worker deploy",
    "release": "bumpp --recursive --git-check --execute \"pnpm verify && trap 'rm -f packages/cli/README.md' EXIT && cp README.md packages/cli/README.md && pnpm --filter @suwujs/king-ai publish --dry-run --no-git-checks\" --commit \"Release v%s\" --tag \"v%s\" --push",
    "release:patch": "pnpm release -- --release patch --yes",
    "release:minor": "pnpm release -- --release minor --yes",
    "release:major": "pnpm release -- --release major --yes"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "kysely": "0.28.17"
    }
  },
  "devDependencies": {
    "bumpp": "^10.4.1",
    "typescript": "^5.7.2"
  }
}
