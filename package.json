{
  "name": "king-ai-monorepo",
  "version": "0.2.79",
  "private": true,
  "type": "module",
  "description": "Monorepo for King AI CLI and app integrations.",
  "scripts": {
    "build": "pnpm --filter @suwujs/king-ai build && pnpm --filter @king-ai/gui-worker build && pnpm --filter @king-ai/docs build",
    "test": "pnpm --filter @suwujs/king-ai test && pnpm --filter @king-ai/gui-worker test && pnpm --filter @king-ai/skills validate",
    "verify": "pnpm build && pnpm test",
    "dev": "node scripts/dev-cli.mjs",
    "docs:dev": "pnpm --filter @king-ai/docs dev",
    "docs:build": "pnpm --filter @king-ai/docs build",
    "docs:preview": "pnpm --filter @king-ai/docs preview",
    "docs:deploy": "pnpm --filter @king-ai/docs run deploy",
    "gui:dev": "pnpm --filter @king-ai/gui-worker dev",
    "gui:dev:lan": "pnpm --filter @king-ai/gui-worker dev:lan",
    "gui:clear-do": "pnpm --filter @king-ai/gui-worker run clear-do",
    "gui:deploy": "pnpm --filter @king-ai/gui-worker run deploy",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "kysely": "0.28.17"
    }
  },
  "devDependencies": {
    "bumpp": "^10.4.1",
    "typescript": "^5.7.2"
  }
}
